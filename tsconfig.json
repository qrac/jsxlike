{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/app.tsx",
    "src/core.ts",
    "src/main.tsx",
    "src/cli.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "test"
  ]
}
