{
  "name": "jsxlike",
  "version": "2.0.0",
  "description": "Convert HTML into editable React JSX using a real HTML parser.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qrac/jsxlike"
  },
  "homepage": "https://jsxlike.qranoko.jp",
  "bin": {
    "jsxlike": "./dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node/core.d.ts",
      "import": "./dist/node/core.js"
    }
  },
  "files": [
    "dist/node",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:h": "vite --host",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:web && npm run build:node",
    "build:web": "vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "preview:h": "vite preview --host",
    "test": "vitest run",
    "test:w": "vitest",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "style-to-js": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
